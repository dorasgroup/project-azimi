PROJECT_NAME=rasad-analysis
ENVIRONMENT=development

FRONTEND_PORT=5173
API_PORT=8010
POSTGRES_PORT=5434
REDIS_PORT=6381

POSTGRES_DB=rasad
POSTGRES_USER=rasad
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://rasad:change-me@postgres:5432/rasad

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

API_CORS_ORIGINS=http://localhost:5173
AUTH_SECRET_KEY=change-this-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# This project uses its dedicated legacy workflow engine deployment in D:\pr\10\legacy-workflow-engine.

CRAWLER_USER_AGENT=RasadAnalysisBot/0.1 (+local-research)
CRAWLER_PAGE_TIMEOUT_MS=30000
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_MAX_PAGES_PER_SOURCE=20
CRAWLER_RESPECT_ROBOTS_TXT=true
# Set false for an immediate rollback to the legacy evidence-only candidate ranker.
CRAWL_HYBRID_RANKING_ENABLED=true
# Worker-only secure egress. The API remains on direct networking.
CRAWL_WORKER_EGRESS_MODE=trusted_proxy
# Optional SOCKS5 endpoint, e.g. host.docker.internal:1080 or user:password@proxy:1080.
CRAWL_UPSTREAM_SOCKS_PROXY=
