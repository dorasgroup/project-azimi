# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=trend_monitor
POSTGRES_USER=trend_monitor
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# X API v2 (optional; required only for monitoring X Sources)
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
X_INITIAL_LOOKBACK_HOURS=24
X_MAX_POSTS_PER_SOURCE=50
X_HTTP_TIMEOUT_SECONDS=15

# Bale Bot API (optional; required only for manual Bale delivery)
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_HTTP_TIMEOUT_SECONDS=15
SITE_BASE_URL=

# Production HTTPS / reverse proxy (leave false for local development)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_HTTPS=false
DJANGO_SECURE_SSL_REDIRECT=false
