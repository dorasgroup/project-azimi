APP_NAME=Ideation RAG Backend
APP_ENV=local
APP_DEBUG=true
ENABLE_PROTOTYPE_ROUTES=false
ASYNC_INGESTION_ENABLED=false
TREND_INTEGRATION_ENABLED=false
# Set only when the integration is enabled. Keep the real values in deployment secrets.
TREND_INTEGRATION_TOKEN=
TREND_INTEGRATION_USER_ID=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideation_rag

JWT_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DIFY_BASE_URL=http://localhost/v1
DIFY_CHAT_API_KEY=app-change-me
DIFY_DATASET_API_KEY=dataset-change-me
DIFY_DATASET_ID=ea1e709d-d175-4da4-8de4-3d2e5e1b5277

UPLOAD_MIN_SIZE_MB=0
UPLOAD_MAX_SIZE_MB=500
UPLOAD_STORAGE_PATH=../storage/uploads
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_VHOST=/
RABBITMQ_PASSWORD=guest
# Explicit development origins only. Production must use its public origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
