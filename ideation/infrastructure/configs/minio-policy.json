{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Deny",
            "Principal": {"AWS": ["*"]},
            "Action": ["s3:GetObject", "s3:PutObject"],
            "Resource": ["arn:aws:s3:::documents-quarantine/*"],
            "Condition": {
                "StringNotEquals": {"aws:SecureTransport": "true"}
            }
        },
        {
            "Effect": "Allow",
            "Principal": {"AWS": ["arn:aws:iam::minio:user/core-api"]},
            "Action": ["s3:PutObject", "s3:GetObject"],
            "Resource": ["arn:aws:s3:::documents-quarantine/*"]
        }
    ]
}
