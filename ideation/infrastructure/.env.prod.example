APP_NAME=Ideation RAG Backend
APP_ENV=production
APP_DEBUG=false
ENABLE_PROTOTYPE_ROUTES=false
ASYNC_INGESTION_ENABLED=false
BALE_INTEGRATION_ENABLED=false
BALE_CONTENT_UPLOAD_ENABLED=false

# Configure these only during the approved activation phase. Keep both secrets
# in root-owned files; never paste them into this environment file.
# BALE_BOT_TOKEN_FILE=/run/secrets/bale_bot_token
# BALE_WEBHOOK_SECRET_FILE=/run/secrets/bale_webhook_secret
# BALE_INTEGRATION_USER_ID=00000000-0000-0000-0000-000000000000

PUBLIC_APP_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

POSTGRES_DB=ideation_rag
POSTGRES_USER=ideation_rag
POSTGRES_PASSWORD=change-this-postgres-password

JWT_SECRET_KEY=change-this-with-openssl-rand-hex-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DIFY_BASE_URL=http://host.docker.internal/v1
DIFY_CHAT_API_KEY=app-change-me
DIFY_DATASET_API_KEY=dataset-change-me
DIFY_DATASET_ID=ea1e709d-d175-4da4-8de4-3d2e5e1b5277

UPLOAD_MIN_SIZE_MB=0
UPLOAD_MAX_SIZE_MB=500

# RabbitMQ password is not stored here. Production Compose reads the root-only file
# /var/lib/ideation-secrets/rabbitmq_password.

LOG_LEVEL=INFO
