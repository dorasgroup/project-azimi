{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Event Schema",
  "description": "Standard schema for tamper-resistant Audit Logs, completely separated from Application Logs.",
  "type": "object",
  "required": ["eventId", "occurredAt", "actor", "action", "resource", "result", "sourceIp"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["user", "service", "admin"] },
        "id": { "type": "string" }
      },
      "required": ["type", "id"]
    },
    "action": {
      "type": "string",
      "examples": ["document.delete", "user.role.update", "tenant.config.change"]
    },
    "resource": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" }
      },
      "required": ["type", "id"]
    },
    "result": {
      "type": "string",
      "enum": ["success", "failure"]
    },
    "reasonCode": {
      "type": "string"
    },
    "traceId": {
      "type": "string",
      "description": "Used to correlate the audit event with technical application traces."
    },
    "sourceIp": {
      "type": "string",
      "description": "IP must be masked or hashed based on strict privacy policies, but stored securely."
    },
    "metadata": {
      "type": "object"
    }
  }
}
