# ================= DATABASE =================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ideation_rag
PGBOUNCER_URL=postgresql+asyncpg://postgres:postgres@pgbouncer:6432/ideation_rag

# ================= CACHE & LOCKS =================
REDIS_URL=redis://redis:6379/0

# ================= MESSAGE BROKER =================
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# ================= OBJECT STORAGE =================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
S3_BUCKET_QUARANTINE=documents-quarantine
S3_BUCKET_APPROVED=documents-approved

# ================= VECTOR DATABASE =================
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=your_secure_weaviate_key

# ================= AI PLATFORM (DIFY) =================
DIFY_API_URL=http://dify-api:5001/v1
DIFY_API_KEY=dataset_or_app_api_key_here

# ================= LLM PROVIDER (AVALAI) =================
AVALAI_API_KEY=your_avalai_api_key

# ================= SECURITY =================
JWT_SECRET=super_secret_jwt_key_that_must_be_rotated
JWT_EXPIRATION=3600
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ================= OBSERVABILITY =================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=info
